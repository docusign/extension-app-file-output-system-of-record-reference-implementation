{
    "name": "File Output SoR",
    "description": {
        "short": "Write files to the system of record",
        "long": "This app writes completed documents to a system of record."
    },
    "publisher": {
        "name": "Fontara",
        "email": "support@fontara.com",
        "phone": "415-555-1212",
        "website": "www.fontara.com"
    },
    "termsOfServiceUrl": "www.fontara.com/tos",
    "privacyUrl": "www.fontara.com/privacy",
    "supportUrl": "www.fontara.com/support",
    "connections": [
        {
            "name": "authentication",
            "description": "secure connection to the app",
            "type": "oauth2",
            "params": {
                "provider": "CUSTOM",
                "scopes": [
                ],
                "grantType": "authorization_code",
                "clientId": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
                "clientSecret": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
                "customConfig": {
                    "authorizationMethod": "header",
                    "authorizationParams": {
                        "prompt": "consent",
                        "access_type": "offline"
                    },
                    "authorizationUrl": "https://app-file-output-system-record-sample-8c6e.azurewebsites.net/api/oauth/authorize",
                    "requiredScopes": [
                    ],
                    "scopeSeparator": " ",
                    "tokenUrl": "https://app-file-output-system-record-sample-8c6e.azurewebsites.net/api/oauth/token",
                    "refreshScopes": [
                    ]
                }
            }
        }
    ],
    "extensions": [
        {
            "name": "File Output to System of Record",
            "description": "Write a file to the system of record",
            "template": "FileIO.Version1.FileOutputSystemOfRecord",
            "actionReferences": [
                "write-file"
            ],
            "capabilities": [
            ]
        },
        {
            "name": "Data Input",
            "description": "Read from the system of record",
            "template": "DataIO.Version6.DataInputOutput",
            "actionReferences": [
                "SearchRecords Action",
                "GetTypeNames Action",
                "GetTypeDefinitions Action"
            ]
        }
    ],
    "actions": [
        {
            "name": "write-file",
            "description": "Write a file to the system of record",
            "template": "FileIO.Version1.WriteFile",
            "connectionsReference": "authentication",
            "params": {
                "uri": "https://app-file-output-system-record-sample-8c6e.azurewebsites.net/api/writefile"
            }
        },
        {
            "name": "SearchRecords Action",
            "description": "Searches a system of record",
            "template": "DataIO.Version6.SearchRecords",
            "connectionsReference": "authentication",
            "params": {
                "uri": "https://app-file-output-system-record-sample-8c6e.azurewebsites.net/api/dataio/searchRecords"
            }
        },
        {
            "name": "GetTypeNames Action",
            "description": "Gets type names from a system of record",
            "template": "DataIO.Version6.GetTypeNames",
            "connectionsReference": "authentication",
            "params": {
                "uri": "https://app-file-output-system-record-sample-8c6e.azurewebsites.net/api/dataio/getTypeNames"
            }
        },
        {
            "name": "GetTypeDefinitions Action",
            "description": "Gets type definitions from a system of record",
            "template": "DataIO.Version6.GetTypeDefinitions",
            "connectionsReference": "authentication",
            "params": {
                "uri": "https://app-file-output-system-record-sample-8c6e.azurewebsites.net/api/dataio/getTypeDefinitions"
            }
        }
    ],
    "publicationRegions": [
        "US"
    ],
    "distribution": "PUBLIC",
    "icon": {
        "data": "",
        "mediaType": "image/png"
    },
    "screenshots": [
    ]
}